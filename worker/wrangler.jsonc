// trawl docs Worker: the review site (static assets from `trawl site -o public`) + a remote MCP server at /mcp.
// Deploy: see README.md in this folder.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trawl-docs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /mcp reaches the Worker code; everything else is served straight from the assets.
    "run_worker_first": ["/mcp", "/mcp/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // owner/name and branch of the docs repo; empty = taken from public/trawl.json.
    "GITHUB_REPO": "",
    "GITHUB_BRANCH": "",
    // "true" serves a read-only /mcp without TRAWL_KEY (only for public docs).
    "PUBLIC_MCP": ""
  }
  // Secrets (wrangler secret put NAME): TRAWL_KEY (required for /mcp), GITHUB_TOKEN (optional, enables write tools).
}
